{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/stone_sword"
    },
    "cases": [
      {
        "when": "dante_sword",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:dante/dante_sword"
        }
      },

      {
        "when": "vessel_nail",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:vessel/nail"
        }
      }

    ]
  }
}
